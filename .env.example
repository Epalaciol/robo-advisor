# Copiar a .env (nunca commitear .env)

# --- App (Streamlit) y desarrollo local: clave pública anon, la seguridad la da RLS ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...

# --- Solo pipeline / scripts de administración (NUNCA en la app ni en Streamlit Cloud) ---
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# --- Opcional ---
# Cadena de conexión directa para aplicar migraciones con psql
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres
